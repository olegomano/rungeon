load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//client/winit/tools:glsl_compile.bzl", "embed_rs")
load("//client/winit/tools:glsl_compile.bzl", "glsl_to_spirv")
package(default_visibility = ["//visibility:public"])


glsl_to_spirv(
    name = "fragment_shader",
    src = ":shader.frag",
)

glsl_to_spirv(
    name = "vertex_shader",
    src = ":shader.vert",
)

embed_rs(
    name = "rust_vertex_shader",
    src = ":vertex_shader",
    var_name = "VERT_SHADER",
)

embed_rs(
    name = "rust_fragment_shader",
    src = ":fragment_shader",
    var_name = "FRAG_SHADER",
)


rust_library(
    name = "indirect_pipeline",
    srcs = ["pipeline.rs", ":rust_fragment_shader", ":rust_vertex_shader"],
    crate_root = "pipeline.rs",
    deps = [
        "@crates//:nalgebra",
        "@crates//:vulkanalia",
        "@crates//:winit",
        "//client/common:handle",
        "//client/winit/common:vulkan_context",
        "//client/winit/common:vulkan_buffer",
        "//client/winit/common:vulkan_texture",
        "//client/winit/common:primitives",
    ],
)
