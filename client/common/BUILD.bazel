load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_rust//rust:defs.bzl", "rust_library")
package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "main",
    srcs = ["main.rs"],
    deps = [
      ":handle",
      ":sparce_buffer"
    ]
)

rust_library(
  name = "handle",
  srcs = ["handle.rs"],
  # Make the crate name match what we use in tests
  crate_name = "handle",
)

rust_library(
  name = "input",
  srcs = ["input.rs"],
  deps = [
    "@crates//:nalgebra"
  ]
)

rust_library(
  name = "transform",
  srcs = ["transform.rs"],
  deps = [
    "@crates//:nalgebra"
  ]
)

rust_library(
  name = "platform",
  srcs = ["platform.rs"],
  deps = [
    "@crates//:nalgebra",
    ":input",
    ":transform"
  ]
)

rust_library(
  name = "sparce_buffer",
  srcs = ["sparce_buffer.rs"],
  deps = [
    ":handle"
  ]
)

rust_library(
  name = "sparce_buffer_rc",
  srcs = ["sparce_buffer_rc.rs"],
  deps = [
    ":handle"
  ],
  # Make the crate name match what we use in tests
  crate_name = "sparce_buffer_rc",
)



rust_library(
  name = "versioned_buffer",
  srcs = ["versioned_buffer.rs"],
  deps = [
    ":handle",
    ":sparce_buffer_rc"
  ]
)



rust_library(
  name = "image",
  srcs = ["image.rs"],
  deps = [
    ":handle",
    "@crates//:image",
  ]
)

rust_library(
  name = "property",
  srcs = ["property.rs"],
  deps = [
    ":handle",
  ]
)

rust_library(
  name = "property_tree",
  srcs = ["property_tree.rs"],
  deps = [
    ":property",
    ":handle",
    ":sparce_buffer_rc",
  ],
)

rust_library(
  name = "mesh",
  srcs = ["mesh.rs"],
  deps = [
    ":handle",
  ]
)
