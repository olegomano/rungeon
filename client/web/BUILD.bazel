# client/web/BUILD.bazel
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load(":wasm_transition.bzl", "wasm_target")

rust_shared_library(
    name = "web_wasm",
    srcs = ["src/lib.rs"],
    edition = "2021",
    deps = [
        "@crates//:wasm-bindgen",
        "@crates//:web-sys",
        "@crates//:js-sys",
    ],
)

rust_wasm_bindgen(
    name = "generate_bindings",
    target = "web",
    wasm_file = ":web_wasm",
)

# Wrapper that applies WASM platform transition to generate_bindings
# This ensures generate_bindings is built with --platforms=@rules_rust//rust/platform:wasm
# without affecting other targets in this package (like py_binary)
wasm_target(
    name = "wasm_bindings",
    src = ":generate_bindings",
)

py_binary(
    name = "serve",
    srcs = ["server.py"],
    data = [
        "static/index.html",
        "static/style.css",
        ":wasm_bindings",
    ],
    main = "server.py",
)

exports_files([
    "src/lib.rs",
    "Cargo.toml",
    "server.py",
    "start_server.sh",
    "build.sh",
    "wasm_transition.bzl",
    "static/index.html",
    "static/style.css",
])
