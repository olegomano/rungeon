bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.73.0")
bazel_dep(name = "rules_rust_prost", version = "0.73.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "toolchains_llvm", version = "1.6.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.6",
    sha256 = {"linux-x86_64": "d55dcbb309de7ade4e3073ec3ac3fac4d3ff236d54df3c4de04464fe68bec531"},
    strip_prefix = {
        "linux-x86_64": "LLVM-19.1.6-Linux-X64",
    },
    urls = {
        "linux-x86_64": [
            "https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.6/LLVM-19.1.6-Linux-X64.tar.xz",
        ],
    },
)

use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")


rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["wasm32-unknown-unknown"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
register_toolchains("@rules_rust_prost//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

wasm_bindgen = use_extension("@rules_rust_wasm_bindgen//:extensions.bzl", "rust_wasm_bindgen")
wasm_bindgen.toolchain(
    wasm_bindgen_version = "0.2.127",
)

# WASM Interop Crates (Pinned strictly to match rules_rust_wasm_bindgen 0.2.121 CLI)
crate.spec(
    package = "wasm-bindgen",
    version = "=0.2.121",
)
crate.spec(
    package = "js-sys",
    version = "=0.3.98",
)
crate.spec(
    package = "web-sys",
    version = "=0.3.98",
    features = [
        "console",
        "OffscreenCanvas",
        "OffscreenCanvasRenderingContext2d",
        "CanvasRenderingContext2d",
        "ImageData",
    ],
)

# Project Crates
crate.spec(
    package = "nalgebra",
    version = "0.33.2",
)
crate.spec(
    package = "prost",
    version = "0.13.1",
)
crate.spec(
    default_features = False,
    package = "prost-types",
    version = "0.13.1",
)
crate.spec(
    package = "winit",
    version = "0.30.12",
)
crate.spec(
    features = [
        "libloading",
        "provisional",
        "window",
    ],
    package = "vulkanalia",
    version = "0.29.0",
)
crate.spec(
    package = "anyhow",
    version = "1.0.75",
)
crate.spec(
    features = ["derive"],
    package = "clap",
    version = "4.5.49",
)
crate.spec(
    package = "image",
    version = "0.24.9",
)
crate.from_specs()
use_repo(crate, "crates")
